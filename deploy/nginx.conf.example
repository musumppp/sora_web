# ============================================================
# 水无月空站 · Nginx 配置示例
# ------------------------------------------------------------
# 用法：把 server_name / root / proxy_pass 三处改成你的实际值
#
# ⚠️ 两段 location 是必须的，缺一个线上就是半死状态：
#   ① try_files        —— 前端路由是 History 模式，不配则「刷新子页面 → 404」
#   ② 接口反向代理      —— 不配则「所有接口 404 → 页面数据全空」
# ============================================================

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com;              # ← 改成你的域名

    # 前端静态文件：npm run build 产出的 dist 目录
    root /var/www/sora_web/dist;              # ← 改成服务器上的实际路径
    index index.html;

    # 留言板/上传等如果传大图，放开请求体上限
    client_max_body_size 50m;

    # ---------- ① SPA 回退 ----------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---------- ② 接口反向代理 ----------
    # 前端用的是相对路径 /log /album /resource，这里转到后端
    location ~ ^/(log|album|resource)/ {
        proxy_pass http://127.0.0.1:8000;     # ← 改成后端实际地址
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---------- 静态资源长缓存 ----------
    # Vite 产物都带 hash，内容变了文件名就变，可以放心长缓存
    location ~* \.(?:js|css|woff2?|webp|png|jpe?g|svg|ico|mp3|ogg)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # index.html 不能缓存 —— 否则发了新版本，访客拿到的还是旧入口，
    # 会去请求已经不存在的旧 hash 文件
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}

# ============================================================
# HTTPS 用 certbot 一行搞定（会自动改写上面的 80 段）：
#   apt install certbot python3-certbot-nginx
#   certbot --nginx -d your-domain.com
# ============================================================
